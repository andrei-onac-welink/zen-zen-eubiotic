{
  "name": "eubiotic",
  "version": "1.0.0",
  "description": "Eubiotic Website",
  "main": "main.js",
  "scripts": {
    "format": "prettier . --write",
    "clean": "rm -rf public resources",
    "build": "sh -c 'if [ \"$CF_PAGES_BRANCH\" = \"main\" ]; then npm run build:production; elif [ \"$CF_PAGES_BRANCH\" = \"staging\" ]; then npm run build:staging; else npm run build:preview; fi'",
    "build:production": "hugo build --logLevel debug -b $CF_PAGES_URL --gc --minify --cacheDir=$PWD/.cache",
    "build:staging": "hugo build -e staging --logLevel debug -b $CF_PAGES_URL --gc --minify --cacheDir=$PWD/.cache",
    "build:preview": "hugo build -e develop --logLevel debug -b $CF_PAGES_URL --gc --minify -D --cacheDir=$PWD/.cache",
    "dev": "hugo server --watch --disableFastRender --ignoreCache",
    "development": "npm run dev",
    "prod": "hugo build -e production --minify --ignoreCache --cleanDestinationDir --gc",
    "production": "npm run prod",
    "lint": "npm run lint:markdown & npm run lint:javascript & npm run lint:style",
    "lint:markdown": "markdownlint **/*.md -i node_modules",
    "lint:javascript": "eslint assets/**/*.js themes/**/assets/**/*.js --no-error-on-unmatched-pattern",
    "lint:style": "stylelint assets/**/*.scss themes/**/assets/**/*.scss --ignore-pattern /vendor/",
    "test": "testcafe chromium:headless tests/",
    "deploy": "node deploy.js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:welink-software/welink-hugo-boilerplate.git"
  },
  "author": "Welink",
  "license": "ISC",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "aos": "^2.3.4",
    "autoprefixer": "^10.5.4",
    "countup.js": "^2.10.1",
    "postcss": "^8.5.21",
    "postcss-cli": "^11.0.1",
    "postcss-media-minmax": "^5.0.0",
    "swiper": "^14.0.6",
    "tailwindcss": "^4.3.3",
    "vanilla-cookieconsent": "^3.1.0"
  }
}
